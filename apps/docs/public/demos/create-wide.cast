[0.7, "o", "\u001b[32m      🌲  🌳  🌲\u001b[39m\r\n          \u001b[32m\u001b[1mWald\u001b[22m\u001b[39m\r\n\r\n  \u001b[2mWhere Git worktrees grow.\u001b[22m\r\n\r\n  \u001b[36m\u001b[1mWorkspace\u001b[22m\u001b[39m \u001b[34mcanopy\u001b[39m \u001b[2m·\u001b[22m \u001b[36m\u001b[1mCurrent\u001b[22m\u001b[39m \u001b[36m\u001b[1mmain\u001b[22m\u001b[39m (\u001b[35mmain\u001b[39m) \u001b[2m·\u001b[22m \u001b[1m1\u001b[22m worktree\r\n\r\n  \u001b[2m“Every tree grows stronger in shared ground.”\u001b[22m\r\n\u001b[2mEsc: exit · Ctrl+C: exit\r\n\u001b[22m\u001b[?25l\u001b[90m│\u001b[39m\r\n\u001b[36m◆\u001b[39m  What would you like to do?\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m Create worktree \u001b[2m(Create an isolated checkout for a branch.)\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mWorktrees…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mCopy current changes to a new worktree…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mProject tasks…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mProject settings…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mMaintenance & diagnostics…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mExit\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m↑/↓\u001b[22m to navigate • \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m└\u001b[39m\r\n"]
[4.4, "o", "\u001b[999D\u001b[11A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  What would you like to do?\r\n\u001b[90m│\u001b[39m  \u001b[2mCreate worktree\u001b[22m\r\n\u001b[?25h\u001b[2mEsc: cancel · Ctrl+C: exit\r\n\u001b[22m\u001b[?25l\u001b[90m│\u001b[39m\r\n\u001b[36m◆\u001b[39m  Create › Branch · Select a branch or create a new one:\r\n\u001b[36m│\u001b[39m\r\n\u001b[36m│\u001b[39m  \u001b[2mSearch:\u001b[22m \u001b[7m\u001b[8m_\u001b[28m\u001b[27m\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m Create a new branch\r\n\u001b[36m│\u001b[39m  \u001b[90m○\u001b[39m \u001b[9m\u001b[90m\u001b[35mmain\u001b[90m  local (in \u001b[36m\u001b[1mmain\u001b[22m\u001b[90m)\u001b[39m\u001b[29m\r\n\u001b[36m│\u001b[39m  \u001b[2m↑/↓\u001b[22m to select • \u001b[2mEnter:\u001b[22m confirm • \u001b[2mType:\u001b[22m to search\r\n\u001b[36m└\u001b[39m"]
[5.0, "o", "\u001b[999D\u001b[7A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Create › Branch · Select a branch or create a new one:\r\n\u001b[90m│\u001b[39m  \u001b[2mCreate a new branch\u001b[22m\r\n\u001b[?25h\u001b[2mEsc: back · Ctrl+C: exit\r\n\u001b[22m\u001b[?25l\u001b[90m│\u001b[39m\r\n\u001b[36m◆\u001b[39m  Create › New branch · Branch name:\r\n\u001b[36m│\u001b[39m  \u001b[7m\u001b[8m_\u001b[28m\u001b[27m\r\n\u001b[36m└\u001b[39m\r\n"]
[5.6, "o", "\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  f█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  fe█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  fea█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  feat█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  featu█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  featur█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  feature█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  feature/█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  feature/s█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  feature/se█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  feature/sea█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  feature/sear█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  feature/searc█\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  feature/search█\u001b[2B\u001b[999D\u001b[4A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Create › New branch · Branch name:\r\n\u001b[90m│\u001b[39m  \u001b[2mfeature/search\u001b[22m\r\n\u001b[?25h\u001b[?25l\u001b[35m◒\u001b[39m  Preparing worktree\u001b[1G\u001b[J\u001b[?25h\r\n\u001b[1mCreate plan\u001b[22m\r\n\u001b[36m\u001b[1mSETTING\u001b[22m\u001b[39m         \u001b[36m\u001b[1mVALUE\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mBranch\u001b[22m\u001b[39m          \u001b[1mfeature/search\u001b[22m\r\n\u001b[36m\u001b[1mStrategy\u001b[22m\u001b[39m        \u001b[1mcreate a new local branch\u001b[22m\r\n\u001b[36m\u001b[1mStarting ref\u001b[22m\u001b[39m    \u001b[1morigin/main\u001b[22m\r\n\u001b[36m\u001b[1mTarget\u001b[22m\u001b[39m          \u001b[1m/demo/canopy/feature-search\u001b[22m\r\n\u001b[36m\u001b[1mCarry source\u001b[22m\u001b[39m    \u001b[1mnone\u001b[22m\r\n\u001b[36m\u001b[1mProject config\u001b[22m\u001b[39m  \u001b[1mtrusted\u001b[22m\r\n\u001b[36m\u001b[1mAutomation\u001b[22m\u001b[39m      \u001b[1m0 pre-create, 1 post-create steps\u001b[22m\r\n\u001b[36m\u001b[1mAfter creation\u001b[22m\u001b[39m  \u001b[1mstay in the current directory\u001b[22m\r\n\u001b[2mEsc: back · Ctrl+C: exit\r\n\u001b[22m\u001b[?25l\u001b[90m│\u001b[39m\r\n\u001b[36m◆\u001b[39m  Create › Review · Ready to create?\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m Create worktree\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mChange options…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mCancel\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m↑/↓\u001b[22m to navigate • \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m└\u001b[39m\r\n"]
[9.3, "o", "\u001b[999D\u001b[7A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Create › Review · Ready to create?\r\n\u001b[90m│\u001b[39m  \u001b[2mCreate worktree\u001b[22m\r\n\u001b[?25h\u001b[90m┌\u001b[39m  \u001b[36m\u001b[1mHook\u001b[22m\u001b[39m \u001b[1mpost_create\u001b[22m\r\n\u001b[90m│\u001b[39m  \u001b[36m\u001b[1mWorktree\u001b[22m\u001b[39m  \u001b[36m\u001b[1mfeature-search\u001b[22m\u001b[39m\r\n\u001b[90m│\u001b[39m  \u001b[36m\u001b[1mBranch\u001b[22m\u001b[39m    \u001b[35mfeature/search\u001b[39m\r\n\u001b[90m│\u001b[39m  \u001b[36m\u001b[1mPath\u001b[22m\u001b[39m      \u001b[34m/demo/canopy/feature-search\u001b[39m\r\n\u001b[?25l\u001b[?25h\u001b[90m│\u001b[39m\r\n\u001b[32m◇\u001b[39m  \u001b[1m1\u001b[22m \u001b[36m\u001b[1mcommand\u001b[22m\u001b[39m  \u001b[32m\u001b[1mnode prepare.mjs\u001b[22m\u001b[39m\r\n\u001b[90m│\u001b[39m  \u001b[2mLocal settings prepared\u001b[22m\r\n\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[90m│\u001b[39m\r\n\u001b[32m◆\u001b[39m  \u001b[32m\u001b[1mDONE\u001b[22m\u001b[39m · 31ms\r\n\u001b[90m│\u001b[39m  \u001b[2mLocal settings prepared\u001b[22m\r\n\u001b[90m│\u001b[39m\r\n\u001b[90m└\u001b[39m  \u001b[32m\u001b[1m1 step · 1 done\u001b[22m\u001b[39m\r\n\r\n\u001b[32m◆\u001b[39m  Created \u001b[36m\u001b[1mfeature-search\u001b[22m\u001b[39m at \u001b[34m/demo/canopy/feature-search\u001b[39m\r\n\u001b[36m\u001b[1mUpstream:\u001b[22m\u001b[39m \u001b[1mnone\u001b[22m\r\n\u001b[36m\u001b[1mPublish with:\u001b[22m\u001b[39m \u001b[32m\u001b[1mgit push -u 'origin' HEAD\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mNext:\u001b[22m\u001b[39m \u001b[32m\u001b[1mwald cd 'feature-search'\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mWithout shell integration:\u001b[22m\u001b[39m \u001b[32m\u001b[1mcd '/demo/canopy/feature-search'\u001b[22m\u001b[39m\r\n\u001b[2mEsc: back · Ctrl+C: exit\r\n\u001b[22m\u001b[?25l\u001b[90m│\u001b[39m\r\n\u001b[36m◆\u001b[39m  What next?\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mOpen \u001b[36m\u001b[1mfeature-search\u001b[22m\u001b[2m\u001b[39m\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mShow navigation command\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m Back to main menu\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mExit\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m↑/↓\u001b[22m to navigate • \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m└\u001b[39m\r\n"]
[9.9, "o", "\u001b[999D\u001b[8A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  What next?\r\n\u001b[90m│\u001b[39m  \u001b[2mBack to main menu\u001b[22m\r\n\u001b[?25h\r\n\u001b[1mWald\u001b[22m · \u001b[34mcanopy\u001b[39m\r\n\u001b[36m\u001b[1mCurrent:\u001b[22m\u001b[39m \u001b[36m\u001b[1mmain\u001b[22m\u001b[39m (\u001b[35mmain\u001b[39m) · \u001b[32mclean\u001b[39m · 2 worktrees\r\n\u001b[2mEsc: exit · Ctrl+C: exit\r\n\u001b[22m\u001b[?25l\u001b[90m│\u001b[39m\r\n\u001b[36m◆\u001b[39m  What would you like to do?\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m Create worktree \u001b[2m(Create an isolated checkout for a branch.)\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mWorktrees…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mCopy current changes to a new worktree…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mProject tasks…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mProject settings…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mMaintenance & diagnostics…\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mExit\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m↑/↓\u001b[22m to navigate • \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m└\u001b[39m\r\n"]
[10.5, "o", "\u001b[999D\u001b[11A\u001b[1B\u001b[J\u001b[31m■\u001b[39m  What would you like to do?\r\n\u001b[90m│\u001b[39m  \u001b[9m\u001b[2mCreate worktree\u001b[22m\u001b[29m\r\n\u001b[90m│\u001b[39m\r\n\u001b[?25h"]
[14.2, "o", "\u001b[2J\u001b[H\u001b[1;32m❯\u001b[0m wald -C feature-search status\r\n"]
[14.8, "o", "\u001b[?25l\u001b[?25h\u001b[36m\u001b[1mWorkspace\u001b[22m\u001b[39m  \u001b[34m/demo/canopy\u001b[39m \u001b[2m·\u001b[22m default \u001b[35mmain\u001b[39m\r\n\u001b[36m\u001b[1mCurrent  \u001b[22m\u001b[39m  \u001b[36m\u001b[1mfeature-search\u001b[22m\u001b[39m \u001b[2m·\u001b[22m \u001b[35mfeature/search\u001b[39m \u001b[2m·\u001b[22m linked \u001b[2m·\u001b[22m \u001b[32mclean\u001b[39m\r\n\u001b[36m\u001b[1mTracking \u001b[22m\u001b[39m  none\r\n\u001b[36m\u001b[1mProject  \u001b[22m\u001b[39m  \u001b[34m/demo/canopy/.wald/project.yml\u001b[39m \u001b[2m·\u001b[22m \u001b[32m\u001b[1mtrusted\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mWorktrees\u001b[22m\u001b[39m  \u001b[1m2\u001b[22m total \u001b[2m·\u001b[22m \u001b[32m2 clean\u001b[39m \u001b[2m·\u001b[22m \u001b[33m0 modified\u001b[39m \u001b[2m·\u001b[22m \u001b[31m0 locked\u001b[39m \u001b[2m·\u001b[22m \u001b[31m0 missing\u001b[39m \u001b[2m·\u001b[22m \u001b[31m0 unavailable\u001b[39m\r\n"]
[18.5, "o", "\u001b[?25l"]
