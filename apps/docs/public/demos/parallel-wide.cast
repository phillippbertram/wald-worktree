[0.1, "o", "\u001b[2J\u001b[H\u001b[1;32m❯\u001b[0m wald create feature/api\r\n"]
[0.7, "o", "\u001b[?25l\u001b[35m◒\u001b[39m  Preparing worktree\u001b[1G\u001b[J\u001b[35m◐\u001b[39m  Preparing worktree\u001b[1G\u001b[J\u001b[?25h\u001b[32m◆\u001b[39m  Created \u001b[36m\u001b[1mfeature-api\u001b[22m\u001b[39m at \u001b[34m/demo/canopy/feature-api\u001b[39m\r\n\u001b[36m\u001b[1mUpstream:\u001b[22m\u001b[39m \u001b[1mnone\u001b[22m\r\n\u001b[36m\u001b[1mPublish with:\u001b[22m\u001b[39m \u001b[32m\u001b[1mgit push -u 'origin' HEAD\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mNext:\u001b[22m\u001b[39m \u001b[32m\u001b[1mwald cd 'feature-api'\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mWithout shell integration:\u001b[22m\u001b[39m \u001b[32m\u001b[1mcd '/demo/canopy/feature-api'\u001b[22m\u001b[39m\r\n"]
[4.4, "o", "\u001b[2J\u001b[H\u001b[1;32m❯\u001b[0m wald create feature/ui\r\n"]
[5.0, "o", "\u001b[?25l\u001b[35m◒\u001b[39m  Preparing worktree\u001b[1G\u001b[J\u001b[35m◐\u001b[39m  Preparing worktree\u001b[1G\u001b[J\u001b[?25h\u001b[32m◆\u001b[39m  Created \u001b[36m\u001b[1mfeature-ui\u001b[22m\u001b[39m at \u001b[34m/demo/canopy/feature-ui\u001b[39m\r\n\u001b[36m\u001b[1mUpstream:\u001b[22m\u001b[39m \u001b[1mnone\u001b[22m\r\n\u001b[36m\u001b[1mPublish with:\u001b[22m\u001b[39m \u001b[32m\u001b[1mgit push -u 'origin' HEAD\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mNext:\u001b[22m\u001b[39m \u001b[32m\u001b[1mwald cd 'feature-ui'\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mWithout shell integration:\u001b[22m\u001b[39m \u001b[32m\u001b[1mcd '/demo/canopy/feature-ui'\u001b[22m\u001b[39m\r\n"]
[8.7, "o", "\u001b[2J\u001b[H\u001b[1;32m❯\u001b[0m wald list\r\n"]
[9.3, "o", "\u001b[?25l\u001b[?25h\u001b[36m\u001b[1mNAME\u001b[22m\u001b[39m         \u001b[36m\u001b[1mBRANCH\u001b[22m\u001b[39m       \u001b[36m\u001b[1mROLE\u001b[22m\u001b[39m    \u001b[36m\u001b[1mSTATUS\u001b[22m\u001b[39m  \u001b[36m\u001b[1mPATH\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mfeature-api\u001b[22m\u001b[39m  \u001b[35mfeature/api\u001b[39m  linked  \u001b[32mclean\u001b[39m   \u001b[34m/demo/canopy/feature-api\u001b[39m\r\n\u001b[36m\u001b[1mfeature-ui\u001b[22m\u001b[39m   \u001b[35mfeature/ui\u001b[39m   linked  \u001b[32mclean\u001b[39m   \u001b[34m/demo/canopy/feature-ui\u001b[39m\r\n\u001b[36m\u001b[1mmain\u001b[22m\u001b[39m         \u001b[35mmain\u001b[39m         linked  \u001b[32mclean\u001b[39m   \u001b[34m/demo/canopy/main\u001b[39m\r\n"]
[13.0, "o", "\u001b[?25l"]
