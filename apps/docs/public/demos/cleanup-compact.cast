[0.1, "o", "\u001b[2J\u001b[H\u001b[1;32m❯\u001b[0m wald remove feature-search --dry-run\r\n"]
[0.7, "o", "\u001b[1mRemoval plan\u001b[22m\r\nBlocked with the current options or project trust.\r\nWorktree: feature-search (/demo/canopy/feature-search)\r\nKeep local branch: feature/search\r\n  Requires force: the worktree contains staged, unstaged, or untracked changes\r\n"]
[4.4, "o", "\u001b[2J\u001b[H\u001b[1;32m❯\u001b[0m wald remove review-ui\r\n"]
[5.0, "o", "review-ui (review/ui, /demo/canopy/review-ui)\r\n\u001b[2mEsc: cancel · Ctrl+C: exit\r\n\u001b[22m\u001b[?25l\u001b[90m│\u001b[39m\r\n\u001b[36m◆\u001b[39m  Remove › Action · What would you like to do?\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m Cancel\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mRemove 1 worktree, keep local branch\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mRemove 1 worktree and delete local branch\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m↑/↓\u001b[22m to navigate • \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m└\u001b[39m\r\n"]
[5.6, "o", "\u001b[999D\u001b[7A\u001b[2B\u001b[J\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mCancel\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m Remove 1 worktree, keep local branch\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mRemove 1 worktree and delete local branch\u001b[22m\r\n\u001b[36m│\u001b[39m  \u001b[2m↑/↓\u001b[22m to navigate • \u001b[2mEnter:\u001b[22m confirm\r\n\u001b[36m└\u001b[39m\r\n\u001b[999D\u001b[7A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Remove › Action · What would you like to do?\r\n\u001b[90m│\u001b[39m  \u001b[2mRemove 1 worktree, keep local branch\u001b[22m\r\n\u001b[?25h\u001b[32m◆\u001b[39m  Removed worktree \u001b[36m\u001b[1mreview-ui\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mBranch kept:\u001b[22m\u001b[39m \u001b[35mreview/ui\u001b[39m\r\n"]
[9.3, "o", "\u001b[2J\u001b[H\u001b[1;32m❯\u001b[0m wald list\r\n"]
[9.9, "o", "\u001b[?25l\u001b[?25h\u001b[36m\u001b[1mfeature-search\u001b[22m\u001b[39m\r\n  Branch  \u001b[35mfeature/search\u001b[39m\r\n  Role    linked\r\n  Status  \u001b[33mmodified\u001b[39m\r\n  Path    \u001b[34m/demo/canopy/feature-search\u001b[39m\r\n\r\n\u001b[36m\u001b[1mmain\u001b[22m\u001b[39m\r\n  Branch  \u001b[35mmain\u001b[39m\r\n  Role    linked\r\n  Status  \u001b[32mclean\u001b[39m\r\n  Path    \u001b[34m/demo/canopy/main\u001b[39m\r\n"]
