[0.7, "o", "\u001b[?25l\u001b[?25h\u001b[36m\u001b[1mWorkspace\u001b[22m\u001b[39m  \u001b[34m/demo/canopy\u001b[39m \u001b[2m·\u001b[22m default \u001b[35mmain\u001b[39m\r\n\u001b[36m\u001b[1mCurrent  \u001b[22m\u001b[39m  \u001b[36m\u001b[1mfeature-search\u001b[22m\u001b[39m \u001b[2m·\u001b[22m \u001b[35mfeature/search\u001b[39m \u001b[2m·\u001b[22m linked \u001b[2m·\u001b[22m \u001b[33mmodified\u001b[39m\r\n\u001b[36m\u001b[1mTracking \u001b[22m\u001b[39m  none\r\n\u001b[36m\u001b[1mProject  \u001b[22m\u001b[39m  none\r\n\u001b[36m\u001b[1mWorktrees\u001b[22m\u001b[39m  \u001b[1m2\u001b[22m total \u001b[2m·\u001b[22m \u001b[32m1 clean\u001b[39m \u001b[2m·\u001b[22m \u001b[33m1 modified\u001b[39m \u001b[2m·\u001b[22m \u001b[31m0 locked\u001b[39m \u001b[2m·\u001b[22m \u001b[31m0 missing\u001b[39m \u001b[2m·\u001b[22m \u001b[31m0 unavailable\u001b[39m\r\n"]
[4.4, "o", "\u001b[2J\u001b[H\u001b[1;32m❯\u001b[0m wald -C feature-search handoff feature/review\r\n"]
[5.0, "o", "\u001b[?25l\u001b[35m◒\u001b[39m  Preparing worktree\u001b[1G\u001b[J\u001b[35m◐\u001b[39m  Preparing worktree\u001b[1G\u001b[J\u001b[?25h\u001b[32m◆\u001b[39m  Created \u001b[36m\u001b[1mfeature-review\u001b[22m\u001b[39m with carried local changes at \u001b[34m/demo/canopy/feature-review\u001b[39m\r\n\u001b[36m\u001b[1mCarried:\u001b[22m\u001b[39m 1 staged, 1 unstaged, 1 untracked\r\n\u001b[36m\u001b[1mSource kept unchanged:\u001b[22m\u001b[39m \u001b[34m/demo/canopy/feature-search\u001b[39m\r\n\u001b[36m\u001b[1mUpstream:\u001b[22m\u001b[39m \u001b[1mnone\u001b[22m\r\n\u001b[36m\u001b[1mPublish with:\u001b[22m\u001b[39m \u001b[32m\u001b[1mgit push -u 'origin' HEAD\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mNext:\u001b[22m\u001b[39m \u001b[32m\u001b[1mwald cd 'feature-review'\u001b[22m\u001b[39m\r\n\u001b[36m\u001b[1mWithout shell integration:\u001b[22m\u001b[39m \u001b[32m\u001b[1mcd '/demo/canopy/feature-review'\u001b[22m\u001b[39m\r\n"]
[8.7, "o", "\u001b[2J\u001b[H\u001b[1;32m❯\u001b[0m wald -C feature-review status\r\n"]
