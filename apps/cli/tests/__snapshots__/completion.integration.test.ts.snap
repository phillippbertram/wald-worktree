// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shell completion scripts > generates the complete bash integration 1`] = `
"# wald navigation integration for bash
wald() {
  local wald_subcommand="" wald_navigate=0 wald_value=0 wald_end=0 wald_help=0 wald_token wald_target
  local -a wald_create_args=()
  for wald_token in "$@"; do
    wald_create_args+=("$wald_token")
    if [ "$wald_value" = 1 ]; then wald_value=0; continue; fi
    if [ "$wald_end" = 1 ]; then continue; fi
    case "$wald_token" in
      --) wald_end=1 ;;
      -C|--directory|--from|--name|--tool) wald_value=1 ;;
      -C?*|--directory=*|--from=*|--name=*|--tool=*) ;;
      -h|--help|-V|--version) wald_help=1 ;;
      --cd) wald_navigate=1 ;;
      -*) ;;
      *)
        if [ -z "$wald_subcommand" ]; then
          wald_subcommand="$wald_token"
          wald_create_args+=("--print-path")
        fi
        ;;
    esac
  done
  if [ "$wald_help" = 1 ]; then command wald "$@"; return $?; fi
  if [ "$wald_subcommand" = cd ]; then
    wald_target="$(command wald "$@")" || return $?
    builtin cd -- "$wald_target" || return $?
    return
  fi
  if [ "$wald_navigate" = 1 ]; then
    case "$wald_subcommand" in
      create|plant|handoff)
        wald_target="$(command wald "\${wald_create_args[@]}")" || return $?
        builtin cd -- "$wald_target" || return $?
        return
        ;;
    esac
  fi
  command wald "$@"
}
# bash completion for wald
__wald_complete() {
  local cur prev cword wald_out wald_line wald_candidate wald_prefix=""
  local -a words wald_args
  if declare -F _get_comp_words_by_ref >/dev/null; then
    _get_comp_words_by_ref -n =: cur prev words cword
  else
    words=("\${COMP_WORDS[@]}")
    cword=$COMP_CWORD
    cur="\${words[cword]}"
  fi
  wald_args=("\${words[@]:1:cword}")
  wald_out=$(command wald complete --shell bash -- "\${wald_args[@]}" 2>/dev/null) || return
  case "$cur" in --*=*) wald_prefix="\${cur%%=*}=" ;; esac
  COMPREPLY=()
  while IFS= read -r wald_line; do
    case "$wald_line" in :*|'') continue ;; esac
    wald_candidate="\${wald_line%%$'\\t'*}"
    if [ -n "$wald_prefix" ] && [[ "$wald_candidate" != "$wald_prefix"* ]]; then
      wald_candidate="$wald_prefix$wald_candidate"
    fi
    if [ -n "$wald_prefix" ] && [[ "$COMP_WORDBREAKS" == *"="* ]]; then
      wald_candidate="\${wald_candidate#"$wald_prefix"}"
    fi
    COMPREPLY+=("$wald_candidate")
  done <<< "$wald_out"
}
complete -o filenames -F __wald_complete wald"
`;

exports[`shell completion scripts > generates the complete fish integration 1`] = `
"# wald navigation integration for fish
function wald
  set -l wald_subcommand ""
  set -l wald_navigate 0
  set -l wald_value 0
  set -l wald_end 0
  set -l wald_help 0
  set -l wald_create_args
  for wald_token in $argv
    set -a wald_create_args "$wald_token"
    if test $wald_value = 1
      set wald_value 0
      continue
    end
    if test $wald_end = 1
      continue
    end
    switch "$wald_token"
      case --
        set wald_end 1
      case -C --directory --from --name --tool
        set wald_value 1
      case '-C?*' '--directory=*' '--from=*' '--name=*' '--tool=*'
      case -h --help -V --version
        set wald_help 1
      case --cd
        set wald_navigate 1
      case '-*'
      case '*'
        if test -z "$wald_subcommand"
          set wald_subcommand "$wald_token"
          set -a wald_create_args --print-path
        end
    end
  end
  if test $wald_help = 1
    command wald $argv
    return $status
  end
  if test "$wald_subcommand" = cd
    set -l wald_target (command wald $argv); or return $status
    builtin cd -- "$wald_target"; or return $status
    return
  end
  if test $wald_navigate = 1; and contains -- "$wald_subcommand" create plant handoff
    set -l wald_target (command wald $wald_create_args); or return $status
    builtin cd -- "$wald_target"; or return $status
    return
  end
  command wald $argv
end
# fish completion for wald
function __wald_complete
  set -l wald_args (commandline -opc)
  set -l wald_current (commandline -ct)
  set -l wald_prefix (string match -r -- '^--[^=]*=' "$wald_current")
  command wald complete -- $wald_args[2..-1] "$wald_current" 2>/dev/null | while read -l wald_line
    if string match -qr -- '^:|^$' "$wald_line"
      continue
    end
    if test -n "$wald_prefix"; and not string match -q -- "$wald_prefix*" "$wald_line"
      printf '%s%s\\n' "$wald_prefix" "$wald_line"
    else
      printf '%s\\n' "$wald_line"
    end
  end
end
complete -c wald -f -a '(__wald_complete)'"
`;

exports[`shell completion scripts > generates the complete zsh integration 1`] = `
"# wald navigation integration for zsh
wald() {
  local wald_subcommand="" wald_navigate=0 wald_value=0 wald_end=0 wald_help=0 wald_token wald_target
  local -a wald_create_args=()
  for wald_token in "$@"; do
    wald_create_args+=("$wald_token")
    if [ "$wald_value" = 1 ]; then wald_value=0; continue; fi
    if [ "$wald_end" = 1 ]; then continue; fi
    case "$wald_token" in
      --) wald_end=1 ;;
      -C|--directory|--from|--name|--tool) wald_value=1 ;;
      -C?*|--directory=*|--from=*|--name=*|--tool=*) ;;
      -h|--help|-V|--version) wald_help=1 ;;
      --cd) wald_navigate=1 ;;
      -*) ;;
      *)
        if [ -z "$wald_subcommand" ]; then
          wald_subcommand="$wald_token"
          wald_create_args+=("--print-path")
        fi
        ;;
    esac
  done
  if [ "$wald_help" = 1 ]; then command wald "$@"; return $?; fi
  if [ "$wald_subcommand" = cd ]; then
    wald_target="$(command wald "$@")" || return $?
    builtin cd -- "$wald_target" || return $?
    return
  fi
  if [ "$wald_navigate" = 1 ]; then
    case "$wald_subcommand" in
      create|plant|handoff)
        wald_target="$(command wald "\${wald_create_args[@]}")" || return $?
        builtin cd -- "$wald_target" || return $?
        return
        ;;
    esac
  fi
  command wald "$@"
}
# zsh completion for wald
_wald() {
  local wald_out wald_line wald_candidate wald_description wald_prefix=""
  local -a wald_args wald_values wald_directories
  wald_args=("\${(@Q)words[2,CURRENT]}")
  wald_out=$(command wald complete -- "\${wald_args[@]}" 2>/dev/null) || return
  case "\${words[CURRENT]}" in --*=*) wald_prefix="\${words[CURRENT]%%=*}=" ;; esac
  for wald_line in "\${(@f)wald_out}"; do
    case "$wald_line" in :*|'') continue ;; esac
    wald_candidate="\${wald_line%%$'\\t'*}"
    wald_description="\${wald_line#*$'\\t'}"
    if [[ -n "$wald_prefix" && "$wald_candidate" != "$wald_prefix"* ]]; then
      wald_candidate="$wald_prefix$wald_candidate"
    fi
    if [[ "$wald_candidate" == */ ]]; then
      wald_directories+=("$wald_candidate")
    else
      wald_values+=("\${wald_candidate//:/\\\\:}:$wald_description")
    fi
  done
  (( \${#wald_directories} )) && compadd -S '' -a wald_directories
  (( \${#wald_values} )) && _describe 'wald' wald_values
  return 0
}
compdef _wald wald"
`;
