{
  "name": "worktree-cli",
  "version": "0.1.0",
  "description": "A small, safe workspace manager for Git worktrees.",
  "private": true,
  "type": "module",
  "bin": {
    "wt": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx src/cli.ts",
    "link:global": "pnpm build && pnpm add --global .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "unlink:global": "pnpm remove --global worktree-cli"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
