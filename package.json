{
  "name": "wald-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm --filter wald-worktree build",
    "build:binary": "pnpm --filter wald-worktree build:binary",
    "dev": "pnpm --filter wald-worktree dev",
    "install:global": "pnpm --filter wald-worktree install:global",
    "start": "pnpm --filter wald-worktree start",
    "test": "pnpm --filter wald-worktree test",
    "test:binary": "pnpm --filter wald-worktree test:binary",
    "test:binary:smoke": "pnpm --filter wald-worktree test:binary:smoke",
    "test:git": "pnpm --filter wald-worktree test:git",
    "test:watch": "pnpm --filter wald-worktree test:watch",
    "typecheck": "pnpm --filter wald-worktree typecheck",
    "uninstall:global": "pnpm --filter wald-worktree uninstall:global",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:dev": "pnpm --filter @wald/docs dev",
    "docs:build": "pnpm --filter @wald/docs build",
    "docs:demos:record": "pnpm build && pnpm --filter @wald/docs demos:record"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10"
  }
}
