{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/coverage",
      "!!node_modules",
      "!!apps/docs/.next",
      "!!apps/docs/.source",
      "!!apps/docs/out",
      "!!apps/docs/test-results",
      "!!apps/docs/playwright-report",
      "!apps/docs/next-env.d.ts",
      "!apps/docs/lib/demos.generated.json",
      "!!packages/cli/skills"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
